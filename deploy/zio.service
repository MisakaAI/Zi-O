[Unit]
Description=ZI/O temporal archive
After=network.target

[Service]
Type=simple
User=zio
Group=zio
WorkingDirectory=/opt/zio
EnvironmentFile=/etc/zio/zio.env
ExecStart=/opt/zio/.venv/bin/uvicorn app.main:app --app-dir /opt/zio/backend --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zio

[Install]
WantedBy=multi-user.target

